{
  "name": "@fushouhai/dsh-workspace-files",
  "version": "0.1.0",
  "type": "module",
  "description": "A fast workspace explorer for DeepSeek Harness: lazy tree, file icons, quick open, ripgrep content search, drag-to-chat paths, and copy/insert file actions.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "build-client.mjs",
    "src",
    "rust/fuzzy/src",
    "rust/fuzzy/fuzzy.wasm",
    "rust/fuzzy/fuzzy.wasm.b64.js",
    "rust/fuzzy/fuzzy.js",
    "rust/fuzzy/build.sh",
    "rust/fuzzy/Cargo.toml",
    "rust/fuzzy/README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build": "node build-client.mjs",
    "prepublishOnly": "node build-client.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=20"
  },
  "author": "fushouhai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigerfsh/dsh-worksapce-files.git"
  },
  "homepage": "https://github.com/tigerfsh/dsh-worksapce-files#readme",
  "bugs": {
    "url": "https://github.com/tigerfsh/dsh-worksapce-files/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workspace-files",
    "file-explorer",
    "ripgrep",
    "tree-view"
  ],
  "publishConfig": {
    "access": "public"
  }
}
